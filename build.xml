<?xml version="1.0" encoding="UTF-8"?>
<project name="TurnosEnfermeria" default="build" basedir=".">

    <description>Compilacion y ejecucion del proyecto con Java 11.</description>

    <property name="src.dir" location="src/main/java"/>
    <property name="classes.dir" location="build/classes"/>
    <property name="main.class" value="TurnosEnfermeria.Main"/>

    <target name="build" description="Compilar el codigo fuente">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               release="11"
               encoding="UTF-8"
               includeantruntime="false"
               debug="true"/>
    </target>

    <target name="run" depends="build" description="Ejecutar el programa">
        <java classname="${main.class}"
              fork="true"
              failonerror="true"
              dir="${basedir}">
            <classpath path="${classes.dir}"/>
        </java>
    </target>

    <target name="clean" description="Eliminar los archivos compilados">
        <delete dir="build"/>
    </target>

    <target name="rebuild"
            depends="clean,build"
            description="Limpiar y compilar"/>

</project>
